{
  "extends": "airbnb-base",
  "plugins": [
    "jsdoc"
  ],
  "env": {
    "browser": true,
    "es2021": true
  },
  "globals": {
    "ui": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-param-reassign": "off",
    "no-underscore-dangle": "off",
    "no-use-before-define": "off",
    "import/extensions": "off",
    "import/no-cycle": "off",
    "import/prefer-default-export": "off",
    "jsdoc/no-undefined-types": 1
  }
}